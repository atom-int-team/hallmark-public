# Image pi-0.84.3-cat1 = pi-0.84.3 byte for byte + a new models.json (adds openai/gpt-6-astra).
#
# Built ON TOP of the old tag, not from the Dockerfile again: a rebuild pulls pip/npm/apt as of
# the build date (without --build-arg PI_VERSION npm installs the latest pi, which has a
# different model catalog), and the arm would no longer be the same. Exactly one file changes.
# Check: diff of `pi --offline --list-models` between the old and new tag = +1 line (Astra).
#
# Build:  docker build -f harness/pi/Dockerfile.cat1 -t hallmark-harness:pi-0.84.3-cat1 harness/pi
FROM hallmark-harness:pi-0.84.3
COPY --chown=agent:agent models.json /home/agent/.pi/agent/models.json
