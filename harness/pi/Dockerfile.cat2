# Image pi-0.84.3-cat2 = pi-0.84.3-cat1 byte for byte + models.json with openai/gpt-6.1-sol.
#
# Built ON TOP of cat1, not from the Dockerfile again (see Dockerfile.cat1 on dependency drift
# when rebuilding). Exactly one file changes. Check: diff of `pi --offline --list-models`
# between the cat1 and cat2 tags = +1 line (6.1 Sol).
#
# Build:  docker build -f harness/pi/Dockerfile.cat2 -t hallmark-harness:pi-0.84.3-cat2 harness/pi
FROM hallmark-harness:pi-0.84.3-cat1
COPY --chown=agent:agent models.json /home/agent/.pi/agent/models.json
